# Copy values into apps/api/.env for the API and apps/web/.env for the web app.
# PostgreSQL must be created separately; no database operation is performed automatically.
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/lumen_social
VITE_API_URL=http://localhost:4000/api
# local (files on disk) or database (PostgreSQL; use on hosts without a durable disk, such as Render).
IMAGE_STORAGE=local
# Optional; defaults to apps/api/var/uploads when the API runs from its workspace.
# IMAGE_UPLOAD_DIR=C:\lumen-social-uploads
