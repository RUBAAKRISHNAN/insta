# Copy values into apps/api/.env for the API and apps/web/.env for the web app.
# PostgreSQL must be created separately; no database operation is performed automatically.
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/lumen_social
VITE_API_URL=http://localhost:4000/api
